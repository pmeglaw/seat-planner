# TypeScript incremental build cache
tsconfig.tsbuildinfo

# next-env.d.ts is generated, and `next dev` and `next build`/`next typegen`
# generate DIFFERENT versions of it — dev points its imports at .next/dev/types,
# build at .next/types — so a committed copy is dirty the moment you run the
# other command. `npm run typecheck` regenerates it (see the typegen step in
# package.json), which is also what makes those imports resolve at all: .next is
# ignored, so on a clean checkout the route declarations do not exist, and
# skipLibCheck lets tsc pass over the missing imports in silence.
next-env.d.ts

# Local Claude Code plugin-enablement config (per-machine)
.claude/settings.json

# Local QA artifacts (screenshots, critique reports, driver output)
/output/
.env*
!.env.local.example

# Design handoff bundles are local reference material (prototype HTML + specs),
# not shipped source. Read them, don't commit them.
/design_handoff_shell_v12/
# The login bundle arrived wrapped around a full copy of repo source
# (components/, lib/, app/globals.css). The handoff docs themselves ARE tracked
# one level up — see docs/design_handoff_login_v12/README.md; only the
# duplicated tree is ignored, because it shadows real files in every search.
/docs/design_handoff_login_v12/ibm-carbon-v12-seats-viewer/

# Production dumps carry the whole employee directory. scripts/backup-prod.mjs
# already refuses to write inside the repo; this is the second line of defence
# for a dump copied here by hand. Deliberately narrow so supabase/migrations
# stays tracked.
seat-planner-*-roles.sql
seat-planner-*-schema.sql
seat-planner-*-data.sql
