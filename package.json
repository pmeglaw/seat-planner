{
  "name": "seat-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern \"supabase/.temp/**\" --ignore-pattern \"supabase/.branches/**\" --ignore-pattern \"coverage/**\" --ignore-pattern \"design_handoff_*/**\" --ignore-pattern \"docs/design_handoff_carbon_v12/support.js\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node --test tests/rpc-execution.test.mjs tests/rls-execution.test.mjs tests/seat-protection-sql-agreement.test.mjs tests/text-length-constraints.test.mjs",
    "test:ct": "node --test tests/login-form.test.mjs tests/update-password-form.test.mjs tests/seat-inspector.test.mjs tests/seat-map-components.test.mjs tests/map-status-legend.test.mjs tests/app-rail.test.mjs tests/app-shell.test.mjs tests/admin-management-panel.test.mjs tests/data-utilities-panel.test.mjs tests/viewer-seat-finder.test.mjs tests/reception-screen.test.mjs",
    "test:browser": "playwright test -c playwright-ct.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test -c playwright-auth.config.ts",
    "db:start": "supabase start",
    "db:seed": "node scripts/seed-local-db.mjs",
    "db:stop": "supabase stop",
    "backup:prod": "node scripts/backup-prod.mjs",
    "coverage": "c8 node --test tests/*.test.mjs",
    "coverage:check": "c8 --check-coverage --lines 90 --functions 95 --branches 80 node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
